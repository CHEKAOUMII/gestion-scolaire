rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function belongsToSchool(schoolId) {
      return request.auth != null
          && request.auth.token.schoolId == schoolId;
    }

    function isSchoolAdmin(schoolId) {
      return belongsToSchool(schoolId)
          && request.auth.token.role in ['principal', 'admin', 'developer'];
    }

    function isDeviceCredential(schoolId) {
      return belongsToSchool(schoolId)
          && request.auth.uid.matches('^device_.*');
    }

    function isActiveSchoolUser(schoolId) {
      return belongsToSchool(schoolId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.status != 'disabled';
    }

    function canSyncSchoolData(schoolId) {
      return isActiveSchoolUser(schoolId) || isDeviceCredential(schoolId);
    }

    function isMigratedSchool(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId))
          && get(/databases/$(database)/documents/schools/$(schoolId)).data.status == 'migrated';
    }

    // Identity change requests — server-only via Cloud Functions
    match /institutionIdentityRequests/{requestId} {
      allow read, write: if false;
    }

    match /schools/{schoolId} {
      allow read: if canSyncSchoolData(schoolId);
      allow create, update, delete: if false;

      match /meta/{metaId} {
        allow read: if isActiveSchoolUser(schoolId);
        allow write: if isSchoolAdmin(schoolId) && isActiveSchoolUser(schoolId);
      }

      match /users/{userId} {
        allow read: if isActiveSchoolUser(schoolId)
            && (request.auth.uid == userId || isSchoolAdmin(schoolId));
        allow write: if isSchoolAdmin(schoolId) && isActiveSchoolUser(schoolId);
      }

      match /userInvites/{inviteId} {
        allow read, write: if isSchoolAdmin(schoolId) && isActiveSchoolUser(schoolId);
      }

      // Existing sync collections remain tenant-scoped without reopening users/meta/invites.
      match /{collection}/{docId} {
        allow read: if !(collection in ['meta', 'users', 'userInvites'])
            && canSyncSchoolData(schoolId);
        allow write: if !(collection in ['meta', 'users', 'userInvites'])
            && canSyncSchoolData(schoolId)
            && !isMigratedSchool(schoolId);
      }
    }

    // SyncLog: devices push change entries, all devices in the school can read
    match /syncLog/{schoolId}/changes/{changeId} {
      allow read: if canSyncSchoolData(schoolId);
      allow write: if canSyncSchoolData(schoolId) && !isMigratedSchool(schoolId);
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
