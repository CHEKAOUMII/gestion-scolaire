  {
    "id": "TC012",
    "title": "Activate app with a valid serial and unlock full access",
    "description": "Verifies that entering a valid license serial activates successfully and removes limited-mode restrictions in the UI.",
    "category": "License Activation & Limited Mode",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login.html"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the username/email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click on the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/index.html\""
      },
      {
        "type": "action",
        "description": "Click on \"License\" or \"Activation\" in the main dashboard"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Activation\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"VALID-SERIAL-KEY\" into the serial key input field"
      },
      {
        "type": "action",
        "description": "Click on the \"Activate\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Activation successful\" is visible"
      },
      {
        "type": "action",
        "description": "Click on \"Timetable\" in the main navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/timetable.html\""
      }
    ]
  },
