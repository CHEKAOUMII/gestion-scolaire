[
  {
    "id": "TC001",
    "title": "Search students by name and open profile modal from results",
    "description": "Verifies that searching by a student name returns results and a student profile modal (grades/KPIs) opens from a selected row.",
    "category": "Student Search & Profile",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login.html"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the username/email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/index.html\""
      },
      {
        "type": "action",
        "description": "Click on \"Students\" to open the Students page"
      },
      {
        "type": "action",
        "description": "Type \"Ahmed\" into the student search field"
      },
      {
        "type": "action",
        "description": "Click the \"Search\" button"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Students results table/list\" is visible"
      },
      {
        "type": "action",
        "description": "Click the first student row in the results list"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Student profile\" modal is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Grades\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Absences\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify text \"KPIs\" is visible"
      }
    ]
  },
