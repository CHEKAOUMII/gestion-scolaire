{
  "name": "gestion-scolaire",
  "version": "1.0.19",
  "description": "برنامج التدبير المدرسي - الثانوية التأهيلية ابن سينا",
  "main": "main.js",
  "scripts": {
    "css:build": "postcss css/tailwind-input.css -o css/tailwind-output.css",
    "css:watch": "postcss css/tailwind-input.css -o css/tailwind-output.css --watch",
    "start": "npm run css:build && set ELECTRON_RUN_AS_NODE=&& electron .",
    "dev": "concurrently \"npm run css:watch\" \"set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "build": "npm run css:build && electron-builder",
    "lint": "eslint \"main/**/*.js\" \"preload.js\" \"js/backup.js\" \"js/pages/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write \"main/**/*.js\" \"preload.js\" \"js/backup.js\" \"js/pages/*.js\" \"tests/**/*.js\" \".github/workflows/*.yml\" \"README.md\"",
    "test:smoke": "node tests/smoke.js",
    "license:key": "node scripts/generate-license-key.js",
    "owner:server": "node server/index.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "concurrently": "^9.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "^3.1014.0",
    "@aws-sdk/client-dynamodb": "^3.1014.0",
    "@aws-sdk/lib-dynamodb": "^3.1014.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "xlsx": "^0.18.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CHEKAOUMII/project6.2.git"
  },
  "build": {
    "appId": "com.ibnsina.gestion-scolaire",
    "productName": "برنامج التدبير المدرسي",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "CHEKAOUMII",
      "repo": "project6.2"
    },
    "files": [
      "**/*",
      ".env",
      "!postcss.config.js",
      "!css/tailwind-input.css"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "${name}-setup-${version}.${ext}"
    }
  }
}
